{
  "name": "ai-advice-nurse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "sources:build": "node scripts/build-notes.js",
    "sources:upload": "node --env-file-if-exists=.env scripts/upload-sources.js",
    "sources:delete": "node --env-file-if-exists=.env scripts/delete-sources.js",
    "evaluate": "node --env-file-if-exists=.env scripts/evaluate.js",
    "summarize": "node scripts/summarize.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "openai": "7.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.8"
  }
}